# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
testbin/
Dockerfile.cross

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool
*.out
cover.html
coverage.txt

# Go workspace files
go.work
go.work.sum

# Dependency directories
vendor/

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# Editor and IDE paraphernalia
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# TLS certificates and keys - NEVER commit these
*.key
*.crt
*.pem
*.p12
*.pfx
hack/tls.*

# Environment and secrets
.env
.env.*
.env.local
*.secret
secrets/
*.secrets.yaml
*.secrets.yml

# Local development
.local/
tmp/
temp/
*.log
*.local.yaml
*.local.yml

# Debug files
debug
*.debug
__debug_bin*

# Test cache and build cache
.cache/
.go-build/

# Air live reload
.air.toml
air.log
